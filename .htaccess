DirectoryIndex index.html

RewriteEngine On

RewriteRule ^servicios/?$ servicios.html [L]
RewriteRule ^proceso/?$ proceso.html [L]
RewriteRule ^precios/?$ precios.html [L]
RewriteRule ^contacto/?$ contacto.html [L]

RewriteRule ^services\.html?$ servicios.html [L,R=301]
RewriteRule ^contact\.html?$ contacto.html [L,R=301]
RewriteRule ^services/?$ servicios.html [L,R=301]
RewriteRule ^contact/?$ contacto.html [L,R=301]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
